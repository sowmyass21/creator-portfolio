# Server Environment Variables (Production & Development)
PORT=5000
NODE_ENV=production
API_PREFIX=/api

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/creator_portfolio?retryWrites=true&w=majority

# CORS Allowed Client Origin (Vercel Frontend URL or local client)
CLIENT_URL=https://your-portfolio.vercel.app
CORS_ORIGIN=http://localhost:5173

# Authentication & Session Security Secrets
JWT_SECRET=your_production_jwt_secret_key_change_in_production_32char
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_production_cookie_secret_key_change_in_production_32char

# Third-Party Platform Integrations
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_CACHE_TTL_MINUTES=15

YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_CACHE_TTL_MINUTES=15

# Email & SMTP Delivery Configuration (Password Reset & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="CreatorPulse Support <support@yourdomain.com>"

